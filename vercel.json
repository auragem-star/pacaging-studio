{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/dieline",
      "dest": "https://packagingdieline.com/api/dieline"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://packagingdieline.com/api/"
    },
    {
      "src": "/studio",
      "dest": "/studio.html"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}